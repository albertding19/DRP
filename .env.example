# Copy to .env for local development.
# `direnv` or `python-dotenv` will pick this up automatically; django-environ
# also reads it via Env.read_env() in config/settings/base.py.

DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-me-in-production-only-used-locally

# Anthropic API key for L2 (Claude Haiku) content-moderation judge.
# Leave empty in dev to skip the API call — moderation.services.judge_with_claude
# fails open when the key is missing, so L1 still runs but L2 is bypassed.
ANTHROPIC_API_KEY=

# LiveKit Cloud credentials for the body-double video calls. Sign up at
# cloud.livekit.io, create a project, and paste the API key, secret, and
# wss:// URL. Leave empty in dev to disable video calls without crashing
# — token issuance will raise on first match, surfaced in the UI.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://drp:drp@localhost:5432/drp

# Redis channel layer
REDIS_URL=redis://localhost:6379/0

# Comma-separated; localhost + 127.0.0.1 covers most dev scenarios
ALLOWED_HOSTS=localhost,127.0.0.1

# Not set locally — Render injects this in prod. Leave blank to render "dev".
RENDER_GIT_COMMIT=
